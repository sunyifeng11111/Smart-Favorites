{
  "name": "smart-favorites",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "wxt build -b chrome",
    "compile": "tsc --noEmit",
    "dev": "wxt -b chrome",
    "evaluate": "tsx scripts/run-evaluation.ts",
